{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor",
  "version": "0.1.0",
  "identifier": "io.github.nunes90.leitor",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Leitor",
        "width": 1000,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
