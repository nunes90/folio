{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.6.0",
  "identifier": "io.github.nunes90.folio",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1000,
        "height": 750
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "frame-src": "blob:",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/capas/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Leitor de EPUB e PDF acessível",
    "longDescription": "Folio é um leitor de livros EPUB e PDF para Linux, com foco em acessibilidade (teclado, leitor de tela, leitura em voz alta) e animações suaves.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "name": "EPUB",
        "description": "Livro EPUB",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF",
        "description": "Documento PDF",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "folio.desktop"
      }
    }
  }
}
